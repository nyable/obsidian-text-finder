{
	"name": "obsidian-text-finder",
	"version": "0.5.0",
	"description": "VSCode-like find/replace in editing mode and rendered-text search in reading mode, with regular expressions and case sensitivity.",
	"main": "main.js",
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=24.21.0 <25"
	},
	"scripts": {
		"dev": "vite build --watch --mode development",
		"typecheck": "vue-tsc --project tsconfig.vue.json --noEmit",
		"build": "pnpm typecheck && vite build",
		"test": "node --test --test-concurrency=1 tests/*.test.mjs",
		"test:browser": "node tests/browser.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"text",
		"find",
		"replace",
		"regular express"
	],
	"author": "hafuhafu",
	"license": "MIT",
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/node": "24.19.2",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"@vitejs/plugin-vue": "6.0.10",
		"jsdom": "26.1.0",
		"obsidian": "1.13.1",
		"postcss": "8.5.26",
		"sass": "^1.79.4",
		"tslib": "2.4.0",
		"typescript": "5.6.2",
		"vite": "8.3.4",
		"vue": "3.5.44",
		"vue-tsc": "3.3.13"
	},
	"dependencies": {
		"@codemirror/language": "6.10.3",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"i18next": "23.15.1",
		"lucide-vue-next": "0.446.0",
		"vanilla-colorful": "0.7.2"
	}
}
