{
	"name": "obsidian-text-finder",
	"version": "0.5.0",
	"description": "VSCode-like find/replace in editing mode and rendered-text search in reading mode, with regular expressions and case sensitivity.",
	"main": "main.js",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24.21.0 <25"
	},
	"scripts": {
		"dev": "vite build --watch --mode development",
		"typecheck": "vue-tsc --project tsconfig.vue.json --noEmit && pnpm typecheck:tests",
		"typecheck:tests": "vue-tsc --project tsconfig.test.json --noEmit",
		"build": "pnpm typecheck && vite build",
		"test": "vitest run",
		"test:artifacts": "node --test --test-concurrency=1 tests/vite-build.test.mjs",
		"test:browser": "playwright test --grep \"production Finder\"",
		"test:visual": "playwright test --grep \"visual contracts\"",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"format:check": "prettier --check src tools tests *.mjs *.json .dependency-cruiser.cjs .github",
		"format": "prettier --write src tools tests *.mjs *.json .dependency-cruiser.cjs .github",
		"check:architecture": "depcruise src --config .dependency-cruiser.cjs",
		"diagnostic": "node tools/diagnostics/run.mjs",
		"verify": "pnpm lint && pnpm format:check && pnpm check:architecture && pnpm test && pnpm test:artifacts && pnpm build && node tools/build/verify-artifacts.mjs && pnpm test:browser",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"text",
		"find",
		"replace",
		"regular express"
	],
	"author": "hafuhafu",
	"license": "MIT",
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@types/jsdom": "30.0.0",
		"@types/node": "24.19.2",
		"@vitejs/plugin-vue": "6.0.10",
		"@vue/test-utils": "2.5.1",
		"dependency-cruiser": "18.7.0",
		"eslint": "10.13.0",
		"eslint-plugin-vue": "10.11.1",
		"jsdom": "30.1.3",
		"obsidian": "1.14.4",
		"postcss": "8.5.31",
		"prettier": "3.9.10",
		"sass": "1.106.1",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"vue": "3.5.44",
		"vue-tsc": "3.3.13"
	},
	"dependencies": {
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"i18next": "26.5.4",
		"lucide-vue-next": "0.446.0",
		"vanilla-colorful": "0.7.2"
	}
}
